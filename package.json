{
  "name": "wonder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:e2e": "node tests/browser.mjs",
    "check": "pnpm release:check && pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm test:e2e",
    "test:firefox": "node tests/firefox-smoke.mjs",
    "format": "prettier --write \"src/ui/**/*.{ts,tsx,css}\" \"src/components/ui/*.tsx\" tests/ui-checks.mjs components.json \"scripts/*release*.mjs\" tests/release.test.mjs \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/ui/**/*.{ts,tsx,css}\" \"src/components/ui/*.tsx\" tests/ui-checks.mjs components.json \"scripts/*release*.mjs\" tests/release.test.mjs \".github/**/*.yml\"",
    "release:check": "node scripts/release-metadata.mjs",
    "release:prepare": "node scripts/prepare-release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/chrome": "^0.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "esbuild": "^0.28.0",
    "eslint": "^10.0.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^16.0.0",
    "jszip": "^3.10.1",
    "playwright": "^1.55.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.69.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.41.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  }
}
